rules_version = '2';

// BookVerse — Firestore security rules.
//
// Collections in use:
//   users/{uid}                    profile + XP (read by anyone signed in,
//                                   so the ranking can show other players'
//                                   name/xp; written only by the owner)
//   users/{uid}/library/{bookId}   personal library — owner-only
//   users/{uid}/progress/{bookId}  reading progress — owner-only
//   users/{uid}/annotations/{id}   highlights + bookmarks — owner-only
//   users/{uid}/lumi/{contextKey}  Lumi AI chat history, one per book —
//                                  owner-only
//   users/{uid}/epubFiles/{bookId} Cloud copy of imported EPUBs, chunked
//                                  under a `chunks` subcollection so the
//                                  same book opens on another device —
//                                  owner-only
//   publicDomainBooks/{id}         Gutenberg text cache — Admin SDK only
//                                  (Cloud Functions bypass these rules), so
//                                  it's intentionally left with no client
//                                  access below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /library/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /progress/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /annotations/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /lumi/{contextKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /goals/{year} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /diary/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Espelho das resenhas publicadas (usado na exclusão de conta).
      match /reviewIndex/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /epubFiles/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /chunks/{chunkId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Resenhas da comunidade: leitura para qualquer usuário logado;
    // cada leitor só escreve a própria resenha (doc id = uid) e contas
    // anônimas não publicam — é preciso ter conta real (Google/e-mail).
    match /books/{bookId}/reviews/{reviewUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == reviewUid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update: if request.auth != null
        && request.auth.uid == reviewUid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null && request.auth.uid == reviewUid;

      // Curtidas: um doc por curtida (doc id = uid de quem curtiu),
      // criar/apagar apenas o próprio, somente com conta real.
      match /likes/{likerUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && request.auth.uid == likerUid
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
        allow update: if false;
      }
    }

    // Explicit default deny for anything else (documentation — this is
    // already the implicit behavior when no rule above matches).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
